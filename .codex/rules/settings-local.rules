# Repository command review; this file grants no automatic command permission.
# Rules are argv-prefix checks outside the sandbox, not a broker firewall.
# Existing task authorization remains valid; runtime approval handling is separate.
# Absolute paths and effective host resolution require separate verification.
# Launcher presence here does not authorize installation or prove it is installed.

prefix_rule(
    pattern = [[
        "python",
        "python3",
        "py",
        "python.exe",
        "python3.exe",
        "py.exe",
        ".venv/Scripts/python.exe",
        "./.venv/Scripts/python.exe",
        ".venv\\Scripts\\python.exe",
        ".\\.venv\\Scripts\\python.exe",
        ".venv/bin/python",
        "./.venv/bin/python",
        ".venv/bin/python3",
        "./.venv/bin/python3",
        "pytest",
        "pytest.exe",
        "pytest-3",
        "pytest3",
    ]],
    decision = "prompt",
    justification = "Interpreters can run arbitrary code or subprocesses. Use the existing task authorization and review the exact target.",
    match = [
        ["python", "--version"],
        ["python3", "--version"],
        ["py", "--version"],
        ["python.exe", "--version"],
        ["python3.exe", "--version"],
        ["py.exe", "--version"],
        [".venv/Scripts/python.exe", "--version"],
        ["./.venv/Scripts/python.exe", "--version"],
        [".venv\\Scripts\\python.exe", "--version"],
        [".\\.venv\\Scripts\\python.exe", "--version"],
        [".venv/bin/python", "--version"],
        ["./.venv/bin/python", "--version"],
        [".venv/bin/python3", "--version"],
        ["./.venv/bin/python3", "--version"],
        ["pytest", "--version"],
        ["pytest.exe", "--version"],
        ["pytest-3", "--version"],
        ["pytest3", "--version"],
    ],
    not_match = [
        ["python-helper", "--version"],
        ["rg", "--files"],
    ],
)

prefix_rule(
    pattern = [[
        "powershell",
        "pwsh",
        "bash",
        "sh",
        "zsh",
        "cmd",
        "powershell.exe",
        "pwsh.exe",
        "bash.exe",
        "sh.exe",
        "cmd.exe",
        "zsh.exe",
    ]],
    decision = "prompt",
    justification = "Shell wrappers can contain multiple operations. Use the existing task authorization and review the exact target.",
    match = [
        ["powershell", "--version"],
        ["pwsh", "--version"],
        ["bash", "--version"],
        ["sh", "--version"],
        ["zsh", "--version"],
        ["cmd", "--version"],
        ["powershell.exe", "--version"],
        ["pwsh.exe", "--version"],
        ["bash.exe", "--version"],
        ["sh.exe", "--version"],
        ["cmd.exe", "--version"],
        ["zsh.exe", "--version"],
    ],
    not_match = [
        ["powershell-helper", "--version"],
        ["rg", "--files"],
    ],
)

prefix_rule(
    pattern = [[
        "railway",
        "railway.exe",
        "railway.cmd",
        "railway.ps1",
    ]],
    decision = "prompt",
    justification = "Review the exact Railway action, project, environment and service. Distinguish bounded reads from secrets, local linking, configuration writes and deployments. Honor existing task authorization and runtime approvals.",
    match = [
        ["railway", "--version"],
        ["railway.exe", "--version"],
        ["railway.cmd", "--version"],
        ["railway.ps1", "--version"],
    ],
    not_match = [
        ["railway-helper", "--version"],
        ["rg", "--files"],
    ],
)

prefix_rule(
    pattern = [[
        "git",
        "git.exe",
    ]],
    decision = "prompt",
    justification = "Git options and aliases can move writes outside a narrow subcommand prefix. Use the existing task authorization and review the exact target.",
    match = [
        ["git", "--version"],
        ["git.exe", "--version"],
    ],
    not_match = [
        ["git-helper", "--version"],
        ["rg", "--files"],
    ],
)

prefix_rule(
