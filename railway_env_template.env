# ══════════════════════════════════════════════════════════════════════════════
# TUYUL FX WOLF-15 LAYER SYSTEM — Railway Environment Template
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy the relevant section into each Railway service's Variables tab.
# Shared variables (Redis, Postgres) must be consistent across services that use them.
# JWT secrets are only needed by wolf15-api (the sole service running FastAPI auth).
#
# Use Railway reference variables where possible:
#   REDIS_URL=${{Redis.REDIS_URL}}
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Generate secrets:
#   openssl rand -hex 32
#
# ══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────
# │ SHARED — Set these on ALL Railway services
# └─────────────────────────────────────────────────────────────────────────────

# Redis (required for ALL services)
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_SOCKET_TIMEOUT_SEC=15
REDIS_SOCKET_CONNECT_TIMEOUT_SEC=10
REDIS_MAX_CONNECTIONS=50
REDIS_POOL_TIMEOUT_SEC=5
REDIS_HEALTH_CHECK_INTERVAL_SEC=30
REDIS_RETRY_ATTEMPTS=5
REDIS_WARMUP_MAX_CONCURRENCY=4
VAULT_REDIS_DEGRADED_LATENCY_MS=100
VAULT_REDIS_BLOCK_LATENCY_MS=500

# PostgreSQL (required for API + Engine; optional for others)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# App identity
APP_NAME=tuyul-fx-wolf-15layer-system
APP_ENV=production
TRADING_MODE=paper
LOG_LEVEL=INFO

# Finnhub (required for Ingest; optional for Engine if CONTEXT_MODE=redis).
# This is the primary key; fallback providers are used only after Finnhub fails.
FINNHUB_API_KEY=<your-finnhub-api-key>
# Twelve Data REST candle fallback (does not replace Finnhub WebSocket ticks)
TWELVE_DATA_API_KEY=<your-twelve-data-api-key>
TWELVE_DATA_CREDITS_PER_MINUTE=8
TWELVE_DATA_QUOTA_WINDOW_SEC=60
TWELVE_DATA_QUOTA_COOLDOWN_SEC=65
# Alpha Vantage REST candle fallback (official key or RapidAPI wrapper)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_RAPIDAPI_KEY=<your-alpha-vantage-rapidapi-key>
ALPHA_VANTAGE_RAPIDAPI_HOST=alpha-vantage.p.rapidapi.com
ALPHA_VANTAGE_CREDITS_PER_MINUTE=5
ALPHA_VANTAGE_QUOTA_WINDOW_SEC=60
ALPHA_VANTAGE_QUOTA_COOLDOWN_SEC=65
# Alpha Vantage fallback for Finnhub free-tier premium errors (H1/H4/D1/W1)
# ALPHAVANTAGE_API_KEY is the canonical name; ALPHA_VANTAGE_API_KEY is also accepted.
ALPHAVANTAGE_API_KEY=<your-alpha-vantage-api-key>
ALPHAVANTAGE_ENABLED=true
ALPHAVANTAGE_RATE_LIMIT_REQUESTS=5
ALPHAVANTAGE_RATE_LIMIT_INTERVAL_SEC=60

# News provider
NEWS_PROVIDER=forexfactory

# Telegram alerts (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ┌─────────────────────────────────────────────────────────────────────────────
# │ wolf15-api (railway.toml)
# └─────────────────────────────────────────────────────────────────────────────

# PORT is auto-injected by Railway
WOLF15_SERVICE_ROLE=api
CONTEXT_MODE=redis

# Auth secrets (only needed by this service — sole FastAPI with JWT auth)
DASHBOARD_JWT_SECRET=<openssl rand -hex 32>
DASHBOARD_API_KEY=<openssl rand -hex 24>

# CORS — add your Vercel production + preview domains
CORS_ORIGINS=https://tuyul-fx-dashboard.vercel.app
VERCEL_FRONTEND_URL=
CORS_ORIGIN_REGEX=
# Vercel project name — enables auto-derived regex for preview deployments
# (preview URLs use project-name pattern: <project>-<hash>-<scope>.vercel.app)
VERCEL_PROJECT_NAME=tuyul-fx-wolf-15-layer-system

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUESTS_PER_MIN=120

# WS hardening
WS_REQUIRE_AUTH=true
WS_PING_INTERVAL=15
WS_HEARTBEAT_TIMEOUT=30

# Governance (MUST stay false — constitutional)
ALLOW_MARKET_EXECUTION=false
ALLOW_DASHBOARD_WRITE=false
COMPLIANCE_MODE_DEFAULT=true

# Cookie settings (production: SameSite=none requires Secure=true)
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_DOMAIN=

# ┌─────────────────────────────────────────────────────────────────────────────
# │ wolf15-engine (railway-engine.toml)
# └─────────────────────────────────────────────────────────────────────────────

# PORT is auto-injected by Railway → ENGINE_HEALTH_PORT
WOLF15_SERVICE_ROLE=engine
RUN_MODE=engine-only
CONTEXT_MODE=redis

# Engine reads candles from Redis Lists seeded by Ingest
CANDLE_HISTORY_KEY_PREFIXES=wolf15:candle_history,candle_history
ENGINE_LOG_SOURCE_URL=https://<engine-service>.up.railway.app/healthz
SIGNAL_JSON_MIN_RR_VALID=2.5
SIGNAL_JSON_TP1_RR_REQUIRED=2.0
SIGNAL_JSON_COUNTER_ENTRY_RISK_MULTIPLIER=0.5
SIGNAL_JSON_COUNTER_ENTRY_EXPIRY_MINUTES=30
SIGNAL_JSON_EMIT_WATCH=true
SIGNAL_JSON_STRICT_LIFECYCLE=true
SIGNAL_JSON_REQUIRE_PARENT_WATCH=false
SIGNAL_JSON_ALLOW_DIRECT_BYPASS=true
SIGNAL_JSON_REQUIRE_FINAL_MARKET_STRUCTURE=false
SIGNAL_JSON_REQUIRE_THEME_ALIGNMENT=false
SIGNAL_JSON_THEME_CONFLICT_DOWNGRADE=false
SIGNAL_JSON_COOLDOWN_M15_BARS_AFTER_ACTIVE_SIGNAL=1
SIGNAL_DECISION_DEDUP_ENABLED=true
SIGNAL_DECISION_STATE_MONOTONIC=true
SIGNAL_JSON_REQUIRE_TERMINAL_DECISION_UPDATE=true
SIGNAL_PRESSURE_STATE_JSON_ENABLED=true
SIGNAL_PRESSURE_STATE_JSON_LOG_PREFIX=[SignalPressureStateJSON]
SIGNAL_PRESSURE_STATE_RATE_LIMIT_SECONDS=60
SIGNAL_PRESSURE_STATE_TRACK_SUPPRESSED=true
SIGNAL_PRESSURE_STATE_SUMMARY_ENABLED=true
SIGNAL_PRESSURE_STATE_SUMMARY_INTERVAL_SECONDS=60
SIGNAL_PRESSURE_STATE_SUMMARY_LOG_PREFIX=[SignalPressureStateSummary]
# Apply migration 20260720_01 and deploy start_pressure_outbox.sh before enabling.
SIGNAL_PRESSURE_OUTBOX_ENABLED=false
SIGNAL_PRESSURE_OUTBOX_WRITE_ENABLED=false
SIGNAL_PRESSURE_OUTBOX_DISPATCH_ENABLED=false
STRATEGY_5SCR_PRESSURE_CONSUMER_ENABLED=false
PRESSURE_OUTBOX_EXPECTED_PHASE=dark
SIGNAL_PRESSURE_OUTBOX_WRITE_TIMEOUT_SECONDS=5
PRESSURE_OUTBOX_WORKER_ID=pressure-worker-1
PRESSURE_OUTBOX_POLL_SECONDS=1
PRESSURE_OUTBOX_BATCH_SIZE=100
PRESSURE_OUTBOX_LEASE_SECONDS=30
PRESSURE_OUTBOX_MAX_ATTEMPTS=8
SIGNAL_PRESSURE_RAW_DIRECTION_MAX_AGE_SECONDS=14400
SIGNAL_THROTTLE_ALLOWED_QUORUM_DECISION_UPDATE_ENABLED=true
SIGNAL_THROTTLE_ALLOWED_QUORUM_DECISION_COOLDOWN_SECONDS=75
SIGNAL_THROTTLE_NO_TRADE_DECISION_UPDATE_ENABLED=true
SIGNAL_THROTTLE_NO_TRADE_DECISION_MIN_EVENTS=3
SIGNAL_THROTTLE_NO_TRADE_DECISION_COOLDOWN_SECONDS=75
# Raw "[SignalThrottle] ... THROTTLED" lines go straight to stderr (NOT via the
# loguru limiter). Min seconds between raw THROTTLED lines per symbol. Unset =
# follows SIGNAL_THROTTLE_WINDOW_SECONDS (300s), matching the clean-block timing
# gate; suppressed repeats fold into "suppressed=N". Log suppression never drops
# the underlying event from the block recorder. Set 15 only to debug raw radar.
# SIGNAL_THROTTLE_ERROR_LOG_MIN_INTERVAL_SECONDS=300
SIGNAL_JSON_FINAL_BARRIER_ENABLED=true
SIGNAL_JSON_EXEC_GATES_ENABLED=true
SIGNAL_JSON_EXEC_GATES_ENFORCE=true
SIGNAL_JSON_EXEC_GATES_EMIT_CONTINUATION=false
SIGNAL_JSON_EXEC_GATES_EMIT_SIDECAR=true
SIGNAL_JSON_EXEC_GATES_MAX_CHASE_R=0.35
SIGNAL_EXECUTION_GATE_JSON_LOG_PREFIX=[SignalExecutionGateJSON]

# HTF context canaries. Enable one stage at a time; defaults remain OFF.
HTF_STRUCTURE_SNAPSHOT_ENABLED=false
HTF_DAILY_PHASE_FEED_ENABLED=false
HTF_DAILY_BIAS_MAX_AGE_SECONDS=259200
HTF_LIQUIDITY_RESOLUTION_MAX_AGE_SECONDS=21600

# Prop firm mode
PROP_FIRM_MODE=true
MAX_CONCURRENT_TRADES=1

# ┌─────────────────────────────────────────────────────────────────────────────
# │ wolf15-ingest (railway-ingestor.toml)
# └─────────────────────────────────────────────────────────────────────────────

# PORT is auto-injected by Railway → INGEST_HEALTH_PORT
WOLF15_SERVICE_ROLE=ingest
CONTEXT_MODE=redis

# Finnhub keys (primary + optional secondary for rotation)
# FINNHUB_API_KEY=<set in shared section>
FINNHUB_API_KEY_SECONDARY=
# Optional extra backup keys. FINNHUB_API_KEY remains primary.
# FINNHUB_API_KEYS=

# Warmup / circuit breaker
WOLF15_INGEST_CB_FAILURE_THRESHOLD=10
WOLF15_INGEST_CB_RECOVERY_TIMEOUT=90

# Producer heartbeat
INGEST_PRODUCER_HEARTBEAT_INTERVAL_SEC=5
INGEST_PRODUCER_FRESHNESS_SEC=20

# WS connect grace window (seconds)
INGEST_WS_CONNECT_GRACE_SEC=45

# ┌─────────────────────────────────────────────────────────────────────────────
# │ wolf15-orchestrator (railway-orchestrator.toml)
# └─────────────────────────────────────────────────────────────────────────────

# PORT is auto-injected by Railway → ORCHESTRATOR_HEALTH_PORT
WOLF15_SERVICE_ROLE=orchestrator
ORCHESTRATOR_CHANNEL=wolf15:orchestrator:commands
ORCHESTRATOR_COMPLIANCE_INTERVAL_SEC=5
ORCHESTRATOR_HEARTBEAT_INTERVAL_SEC=30
ORCHESTRATOR_LOOP_SLEEP_SEC=0.5

# ┌─────────────────────────────────────────────────────────────────────────────
# │ wolf15-execution (railway-execution.toml)
# └─────────────────────────────────────────────────────────────────────────────

WOLF15_SERVICE_ROLE=execution
CONTEXT_MODE=redis

# EA bridge
EA_BRIDGE_ENABLED=true

# Broker (if running MT5 bridge)
BROKER_EXECUTOR=off
BROKER_ACCOUNT_ID=
BROKER_SERVER=
BROKER_PASSWORD=

# ┌─────────────────────────────────────────────────────────────────────────────
# │ Workers (backtest / montecarlo / regime)
# └─────────────────────────────────────────────────────────────────────────────

# wolf15-worker-backtest
WOLF15_WORKER_ENTRY=backtest

# wolf15-worker-montecarlo
WOLF15_WORKER_ENTRY=montecarlo

# wolf15-worker-regime
WOLF15_WORKER_ENTRY=regime

# ┌─────────────────────────────────────────────────────────────────────────────
# │ Dashboard (Vercel — NOT Railway)
# └─────────────────────────────────────────────────────────────────────────────
# Set these in Vercel project → Settings → Environment Variables:

# Public (inlined into client JS bundle at build time)
# NEXT_PUBLIC_API_BASE_URL=            # leave empty — REST goes through /api/proxy
# NEXT_PUBLIC_WS_BASE_URL=wss://wolf15-api-production.up.railway.app

# Server-only (available to middleware + route handlers, never in bundle)
# INTERNAL_API_URL=https://wolf15-api-production.up.railway.app
# DASHBOARD_MODE=owner
# API_KEY=<same value as Railway DASHBOARD_API_KEY>

# Optional: Dashboard-BFF upstream (server-side only).
# When set, the proxy routes BFF-allowlisted paths to this URL.
# INTERNAL_DASHBOARD_BFF_URL=https://wolf15-dashboard-bff.up.railway.app

# ┌─────────────────────────────────────────────────────────────────────────────
# │ wolf15-dashboard-bff (optional — Railway)
# └─────────────────────────────────────────────────────────────────────────────
# Non-authoritative dashboard BFF for aggregation and caching.
# See docs/architecture/dashboard-hybrid-topology.md.

# WOLF15_SERVICE_ROLE=dashboard-bff
# REDIS_URL=${{Redis.REDIS_URL}}
# INTERNAL_API_URL=https://wolf15-api-production.up.railway.app
# LOG_LEVEL=INFO

# ┌─────────────────────────────────────────────────────────────────────────────
# │ Observability Auth (all services exposing /health, /readyz, /metrics)
# └─────────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Must be identical across ALL services that serve or scrape these endpoints.
OBSERVABILITY_AUTH_MODE=required
OBSERVABILITY_MACHINE_KEY=<openssl rand -hex 32>

# ┌─────────────────────────────────────────────────────────────────────────────
# │ Observability Telemetry (optional — all services)
# └─────────────────────────────────────────────────────────────────────────────

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENV=production
