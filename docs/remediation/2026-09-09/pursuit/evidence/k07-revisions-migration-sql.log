        tradeplan_id uuid NOT NULL, revision integer NOT NULL CHECK(revision>0),
        symbol text NOT NULL, reevaluation_id uuid NOT NULL UNIQUE,
        predecessor_revision integer, predecessor_hash text,
        request_hash text NOT NULL CHECK(request_hash ~ '^sha256:[0-9a-f]{64}$'),
