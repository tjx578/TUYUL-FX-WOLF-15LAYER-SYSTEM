          REFERENCES public.strategy_5scr_candidate_revisions_v31(tradeplan_id,revision,request_hash),
        CHECK ((revision=1 AND predecessor_revision IS NULL AND predecessor_hash IS NULL)
            OR (revision>1 AND predecessor_revision IS NOT NULL AND predecessor_revision=revision-1
                AND predecessor_hash IS NOT NULL)),
