CREATE FUNCTION public.guard_5scr_candidate_revision_v31() RETURNS trigger LANGUAGE plpgsql AS $$
    DECLARE owner_token uuid; latest integer;
    BEGIN
        IF TG_OP <> 'INSERT' THEN RAISE EXCEPTION 'CANDIDATE_REVISION_IMMUTABLE'; END IF;
        PERFORM pg_advisory_xact_lock(hashtextextended('5scr-owner:' || NEW.symbol,0));
        SELECT token INTO owner_token FROM public.strategy_5scr_owner_fences_v1 WHERE symbol=NEW.symbol FOR UPDATE;
        IF owner_token IS NULL OR owner_token::text IS DISTINCT FROM current_setting('wolf15.lifecycle_owner_token',true)
        THEN RAISE EXCEPTION 'STALE_OR_UNBOUND_LIFECYCLE_OWNER'; END IF;
        SELECT max(revision) INTO latest FROM public.strategy_5scr_candidate_revisions_v31 WHERE tradeplan_id=NEW.tradeplan_id;
        IF NEW.revision <> COALESCE(latest,0)+1 THEN RAISE EXCEPTION 'CANDIDATE_REVISION_PREDECESSOR_CONFLICT'; END IF;
        RETURN NEW;
    END; $$;

CREATE TRIGGER guard_5scr_candidate_revision_v31 BEFORE INSERT OR UPDATE OR DELETE
