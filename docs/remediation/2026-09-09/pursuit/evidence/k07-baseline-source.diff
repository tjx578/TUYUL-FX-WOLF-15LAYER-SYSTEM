+def baseline_refresh_hash_v31(evidence: CapacityBaselineRefreshV31) -> str:
+    payload = evidence.model_dump(mode="json")
+    payload["excluded_reservation_ids"] = sorted(payload["excluded_reservation_ids"])
+    return _hash(payload)
+
