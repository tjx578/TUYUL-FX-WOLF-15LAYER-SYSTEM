+        now=later,
+        expected_version=0,
+        verify_handoff=None,
+        verify_universe=None,
+        verify_risk_inputs=None,
+    )
+    assert retry.status == "DUPLICATE_TEST_ONLY" and retry.ledger == committed
+    assert retry.execution_authority is False
