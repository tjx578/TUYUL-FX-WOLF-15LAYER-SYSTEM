{
  "schema": "wolf15.runtime-credential-pipe-contract.v1",
  "transport": "WINDOWS_LOCAL_NAMED_PIPE",
  "pipe_name_prefix": "wolf15-lean-d0-",
  "server_identity": "CURRENT_WINDOWS_USER",
  "maximum_server_instances": 1,
  "serve_modes": [
    "once",
    "persistent"
  ],
  "default_serve_mode": "once",
  "once_mode": {
    "serve_count": 1,
    "exit_after_success": true
  },
  "persistent_mode": {
    "connections": "UNBOUNDED_UNTIL_PROCESS_EXIT",
    "vault_revalidation": "PER_CONNECTION",
    "dpapi_decrypt": "PER_CONNECTION",
    "secrets_retained_between_connections": false,
    "wait_timeout_behavior": "CONTINUE_LISTENING"
  },
  "frame": {
    "header": "8_ASCII_DECIMAL_BYTES",
    "payload": "UTF8_CANONICAL_JSON",
    "maximum_payload_bytes": 4096,
    "completion": "EXACT_HEADER_AND_DECLARED_PAYLOAD_LENGTH",
    "minimum_payload_bytes": 1,
    "client_after_payload": "CLOSE_HANDLE_WITHOUT_EOF_PROBE",
    "bytes_after_payload": "OUTSIDE_FRAME_NOT_READ_OR_PARSED",
    "server_frames_per_connection": 1,
    "read_deadline_ms": 5000,
    "deadline_scope": "SHARED_HEADER_PAYLOAD_CHECKED_BETWEEN_SYNCHRONOUS_READS"
  },
  "envelope_schema": "wolf15.runtime_credentials.v1",
  "exact_ordered_fields": [
    "schema",
    "executor_id",
    "account_reference_sha256",
    "verification_key_id",
    "executor_token",
    "verification_material"
  ],
  "credential_fields": [
    "executor_token",
    "verification_material"
  ],
  "network_access": false,
  "plaintext_files": false,
  "console_secret_output": false,
  "dll_import_required_by_mq5": false,
  "server_identity_binding": "RUNTIME_SID",
  "optional_expected_user_sid_argument": true,
  "account_reference_sha256_authority": "LOCAL_CREDENTIAL_BINDING_ONLY",
  "account_identity_authority": "CHANNEL_B_W15AB_V1",
  "secret_zeroization": "BEST_EFFORT_BYTE_BUFFERS_ONLY"
}
