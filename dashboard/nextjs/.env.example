# WOLF15 G4 visual dashboard — viewer-only profile
#
# Production values belong in Railway service variables. Do not commit secrets,
# JWTs, API keys, cookies, or credential-bearing URLs.

# Required runtime profile.
DASHBOARD_MODE=viewer

# Core auth authority used only by server-side session validation.
INTERNAL_API_URL=http://localhost:8000

# Dashboard BFF used only by the three exact read projections.
INTERNAL_DASHBOARD_BFF_URL=http://localhost:8080

# Optional legacy client configuration. The G4 root page does not make direct
# browser calls to core and does not open WebSockets.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Local display preference only.
NEXT_PUBLIC_TIMEZONE=Asia/Makassar
