# Existing Railway frontend. This service holds no machine credentials.
DASHBOARD_MODE=viewer
DASHBOARD_CANONICAL_ORIGIN=https://wolf15-dashboard-frontend-production.up.railway.app
INTERNAL_API_URL=https://wolf15-api-production.up.railway.app
PORT=8080

# Local development overrides (use a separate local API):
# DASHBOARD_CANONICAL_ORIGIN=http://localhost:3000
# INTERNAL_API_URL=http://localhost:8000
# PORT=3000
# Owner verifier and JWT signing secret belong only on the API service.
