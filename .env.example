# ==========================================================
# TUYUL FX — WOLF 15-LAYER SYSTEM (.env)
# Copy this file to ".env" and fill in the values.
# NEVER commit real secrets to git.
# ==========================================================

# -----------------------
# APP MODE
# -----------------------
APP_NAME="tuyul-fx-wolf-15layer-system"
APP_ENV="dev"                 # dev | staging | prod
ENV="development"             # development | production (api_server.py)
DEBUG="false"
ENABLE_DEV_ROUTES="false"
TRADING_MODE="paper"          # paper | live
LOG_LEVEL="INFO"              # DEBUG | INFO | WARNING | ERROR
TIMEZONE="Asia/Singapore"     # GMT+8 timezone for local display and session detection

# -----------------------
# SIGNAL JSON / MICROBOOST TIMING
# -----------------------
# Final standalone signal log. Raw throttle/microboost telemetry remains separate.
SIGNAL_JSON_LOG_ENABLED="true"
SIGNAL_JSON_LOG_PREFIX="[SignalJSON]"
SIGNAL_JSON_LOG_LEVEL="WARNING"
SIGNAL_JSON_EMIT_WATCH="true"
SIGNAL_JSON_EMIT_CONDITIONAL="true"
SIGNAL_JSON_EMIT_VALID="true"
SIGNAL_JSON_EMIT_ONLY_WITH_MARKET_CONTEXT="true"
SIGNAL_JSON_DEDUP_TTL_SECONDS="300"
SIGNAL_WATCH_JSON_LOG_PREFIX="[SignalWatchJSON]"
SIGNAL_WATCH_JSON_LOG_LEVEL="INFO"
SIGNAL_DECISION_UPDATE_JSON_LOG_PREFIX="[SignalDecisionUpdateJSON]"
SIGNAL_DECISION_UPDATE_JSON_LOG_LEVEL="INFO"
SIGNAL_WATCH_EMIT_ON_TRANSITION_ONLY="true"
# P2A Opsi A: attach non-executable market_structure + tradeplan_preview to
# EARLY_SELL_WATCH (key levels, invalidation, SL/TP preview from market_context_snapshot).
# Observability/plan only — never changes status/requires_m15_close/valid_for_execution,
# never emits SignalJSON. Flag OFF = byte-identical. Keep OFF until reviewed.
SIGNAL_WATCH_MARKET_STRUCTURE_PREVIEW_ENABLED="false"
# P2A-General: EVERY official *_WATCH gets market_structure_status + structure_class +
# structure_pending_reason (and a directional tradeplan_preview when structure is ready).
# Market structure -- not the pattern name -- is the reference. Preview-only: never changes
# status/requires_m15_close/valid_for_execution, never emits SignalJSON. Flag OFF = byte-identical.
SIGNAL_WATCH_MARKET_STRUCTURE_STATUS_ENABLED="false"
# Patch B (flag-guarded, default OFF): a valid clean SignalThrottle block (>= clean_block_seconds,
# default 300s) carrying its OWN BUY/SELL direction must still emit a SignalWatchJSON
# (CLEAN_BLOCK_BUY_WATCH / CLEAN_BLOCK_SELL_WATCH) + a PENDING market_structure object when the
# microboost direction is MISSING. An OPPOSITE microboost direction stays a conflict (no fallback).
# Watch-only: final_direction=WAIT, valid_for_execution=false, never a SignalJSON. Does NOT lower
# the clean-block threshold. OFF = byte-identical.
SIGNAL_WATCH_ALLOW_CLEAN_BLOCK_DIRECTION_FALLBACK="false"
# P2.6: every valid clean block must produce either SignalWatchJSON or an explicit
# SignalWatchPromotionDiagnostic. Default ON because silent drop is no longer allowed.
SIGNAL_WATCH_PROMOTION_DIAGNOSTIC_ENABLED="true"
SIGNAL_WATCH_PROMOTION_DIAGNOSTIC_LOG_PREFIX="[SignalWatchPromotionDiagnostic]"
SIGNAL_WATCH_PROMOTION_DIAGNOSTIC_PRODUCTION_GATE_ENABLED="true"
SIGNAL_WATCH_PROMOTION_DIAGNOSTIC_DEBUG_ENABLED="false"
SIGNAL_WATCH_PROMOTION_SUMMARY_ENABLED="true"
SIGNAL_WATCH_PROMOTION_SUMMARY_INTERVAL_SECONDS="300"
SIGNAL_WATCH_PROMOTION_SUMMARY_LOG_PREFIX="[SignalWatchPromotionSummary]"
# Scanner-cycle clean blocks are not primary pair-rotation authority, but mature
# pressure memory with market context may emit advisory SignalWatchJSON so the
# operator can see HTF-led watch planning. Execution remains locked.
SIGNAL_THROTTLE_SCANNER_MEMORY_ADVISORY_WATCH_ENABLED="true"
SIGNAL_THROTTLE_SCANNER_MEMORY_ADVISORY_MIN_SECONDS="300"
SIGNAL_THROTTLE_SCANNER_MEMORY_ADVISORY_MIN_EVENTS="12"
SIGNAL_THROTTLE_CANDIDATE_MARKET_CONTEXT_ENABLED="true"
SIGNAL_THROTTLE_CANDIDATE_MARKET_CONTEXT_MAX_SYMBOLS="12"
# The main SignalThrottle snapshot (clean-block Watch promotion) only runs on
# EXECUTE verdicts, coupling Watch cadence to EXECUTE cadence. When enabled, this
# also routes mature clean blocks to SignalWatch on non-EXECUTE cycles, rate
# limited by the interval below. Observability-only: still price-integrity gated
# and valid_for_execution=false. Default off for conservative rollout.
SIGNAL_WATCH_IDLE_PROMOTION_ENABLED="false"
SIGNAL_WATCH_IDLE_PROMOTION_INTERVAL_SECONDS="60"
SIGNAL_JSON_STRICT_LIFECYCLE="true"
SIGNAL_JSON_REQUIRE_PARENT_WATCH="false"
SIGNAL_JSON_ALLOW_DIRECT_BYPASS="false"
SIGNAL_WATCH_PRODUCTION_GATE_ENABLED="true"
# A production Watch is candidate intelligence. Keep this false so H4/D1
# decision-grade requirements are evaluated by SignalDecisionUpdateJSON, not
# used to hide a valid non-executable Watch. Set true only for rollback.
SIGNAL_WATCH_REQUIRE_DECISION_GRADE_CONTEXT="false"
SIGNAL_PRICE_INTEGRITY_ENABLED="true"
SIGNAL_PRICE_INTEGRITY_GATE_ENABLED="true"
SIGNAL_PRICE_MAX_QUOTE_AGE_SECONDS="5"
SIGNAL_PRICE_MAX_FUTURE_SKEW_SECONDS="1"
SIGNAL_PRICE_RANGE_BUFFER="0"
# Pressure-channel mirror of the Watch-path price-integrity contract. When
# enabled, pressure-state payloads without a LIVE observed quote null
# signal_valid_price/entry_reference_price/entry_zone (originals stay in
# reference_signal_price/reference_entry_price) so a stale reference can never
# masquerade as four independent entry prices. Default off for rollout.
SIGNAL_PRESSURE_ENTRY_FIELD_INTEGRITY_ENABLED="false"
# Optional uniform override for per-source reference-price max age (seconds)
# used to downgrade AVAILABLE references to STALE on the pressure channel.
# Empty = per-source defaults (LIVE_TICK 60, M15_CLOSE 1800, H1_CLOSE 7200, ...).
SIGNAL_PRESSURE_REFERENCE_MAX_AGE_SECONDS=""
# Market-hours tick-feed heartbeat: emits a rate-limited [TickFeedHeartbeat]
# ERROR when the forex market is open but no symbol has produced a tick within
# the silence budget (plus a recovery notice when ticks resume). Startup grace
# also applies after the Sunday reopen so Friday-stale ticks do not false-alarm
# before the websocket reconnects. Observability-only.
TICK_FEED_HEARTBEAT_ENABLED="false"
TICK_FEED_HEARTBEAT_MAX_SILENCE_SECONDS="300"
TICK_FEED_HEARTBEAT_ALERT_INTERVAL_SECONDS="600"
TICK_FEED_HEARTBEAT_STARTUP_GRACE_SECONDS="600"
DIRECT_ABSORPTION_VALID_ENABLED="false"
SIGNAL_TRADEPLAN_VOLATILITY_BUFFER_ENABLED="true"
SIGNAL_TRADEPLAN_H4_ATR_STOP_BUFFER_RATIO="0.10"
SIGNAL_TRADEPLAN_SPREAD_STOP_BUFFER_MULTIPLIER="1.5"
SIGNAL_WATCH_INTERNAL_SUMMARY_ENABLED="true"
SIGNAL_WATCH_INTERNAL_SUMMARY_INTERVAL_SECONDS="300"
SIGNAL_WATCH_INTERNAL_SUMMARY_LOG_PREFIX="[SignalWatchInternalSummary]"
SIGNAL_WATCH_INTERNAL_SUMMARY_LOG_LEVEL="INFO"
SIGNAL_JSON_REQUIRE_FINAL_MARKET_STRUCTURE="false"
SIGNAL_JSON_REQUIRE_THEME_ALIGNMENT="false"
SIGNAL_JSON_THEME_CONFLICT_DOWNGRADE="false"
SIGNAL_JSON_COOLDOWN_M15_BARS_AFTER_ACTIVE_SIGNAL="1"
SIGNAL_DECISION_DEDUP_ENABLED="true"
SIGNAL_DECISION_STATE_MONOTONIC="true"
SIGNAL_JSON_REQUIRE_TERMINAL_DECISION_UPDATE="true"
SIGNAL_DECISION_SOURCE_GUARD_ENABLED="true"
SIGNAL_PRESSURE_STATE_JSON_ENABLED="true"
SIGNAL_PRESSURE_STATE_JSON_LOG_PREFIX="[SignalPressureStateJSON]"
# Keep the state stream sampled while exposing every attempted/suppressed outcome
# through the rolling summary marker below.
SIGNAL_PRESSURE_STATE_RATE_LIMIT_SECONDS="60"
SIGNAL_PRESSURE_STATE_TRACK_SUPPRESSED="true"
SIGNAL_PRESSURE_STATE_SUMMARY_ENABLED="true"
SIGNAL_PRESSURE_STATE_SUMMARY_INTERVAL_SECONDS="60"
SIGNAL_PRESSURE_STATE_SUMMARY_LOG_PREFIX="[SignalPressureStateSummary]"
# Durable Strategy 5S-CR pressure transport. Keep disabled until migration
# 20260720_02 is applied and the dedicated worker service is deployed.
SIGNAL_PRESSURE_OUTBOX_ENABLED="false"
SIGNAL_PRESSURE_OUTBOX_WRITE_ENABLED="false"
# Route pressure through the durable deferred-lineage radar. This requires both
# outbox flags above and remains false until radar shadow validation is approved.
SIGNAL_PRESSURE_RADAR_WRITE_ENABLED="false"
SIGNAL_PRESSURE_OUTBOX_DISPATCH_ENABLED="false"
STRATEGY_5SCR_PRESSURE_CONSUMER_ENABLED="false"
PRESSURE_OUTBOX_EXPECTED_PHASE="dark"
SIGNAL_PRESSURE_OUTBOX_WRITE_TIMEOUT_SECONDS="5"
SIGNAL_PRESSURE_RADAR_WRITE_TIMEOUT_SECONDS="5"
PRESSURE_OUTBOX_WORKER_ID="pressure-worker-1"
PRESSURE_OUTBOX_POLL_SECONDS="1"
PRESSURE_OUTBOX_BATCH_SIZE="100"
PRESSURE_OUTBOX_LEASE_SECONDS="30"
PRESSURE_OUTBOX_MAX_ATTEMPTS="8"
# Raw direction is pressure radar only and expires after the H4 horizon.
SIGNAL_PRESSURE_RAW_DIRECTION_MAX_AGE_SECONDS="14400"
SIGNAL_THROTTLE_PRESSURE_DECISION_BYPASS_DISABLED="true"
SIGNAL_DECISION_REQUIRE_LIFECYCLE_ANCHOR="true"
SIGNAL_THROTTLE_SOURCE_MAX_AGE_SECONDS="300"
# Current timing authority is deliberately shorter than source freshness.
MICROBOOST_ACTIVE_TIMING_MAX_AGE_SECONDS="120"
# Historical Microboost may wait for clean-block maturity, but cannot time a Watch.
MICROBOOST_LINEAGE_WAIT_GRACE_SECONDS="420"
MICROBOOST_SOURCE_GUARD_ENABLED="true"
MICROBOOST_SOURCE_DIAGNOSTIC_LOG_PREFIX="[MicroboostSourceDiagnostic]"
MICROBOOST_STALE_DIAGNOSTIC_LOG_PREFIX="[MicroboostStaleDiagnostic]"
MICROBOOST_STALE_CLUSTER_TERMINALIZATION_ENABLED="true"
MICROBOOST_STALE_CLUSTER_TERMINAL_CACHE_SIZE="512"
MICROBOOST_OBSERVABILITY_LOGGER="microboost_observability"
SIGNAL_THROTTLE_FRESHNESS_DIAGNOSTIC_LOG_PREFIX="[SignalThrottleFreshnessDiagnostic]"
SIGNAL_WATCH_SOURCE_GUARD_ENABLED="true"
SIGNAL_WATCH_LINEAGE_MISSING_TERMINAL_THRESHOLD="3"
# Backfill a missing Microboost parent only after pair, raw direction, event
# time, and (when present) deployment all match a mature clean-block ledger.
SIGNAL_WATCH_LINEAGE_BACKFILL_ENABLED="true"
SIGNAL_WATCH_LINEAGE_BACKFILL_MAX_TIME_DISTANCE_SECONDS="300"
SIGNAL_THROTTLE_STATE_SNAPSHOT_ENABLED="true"
SIGNAL_THROTTLE_STATE_SNAPSHOT_INTERVAL_SECONDS="60"
SIGNAL_THROTTLE_STATE_SNAPSHOT_LOG_PREFIX="[SignalThrottleStateSnapshot]"
SIGNAL_THROTTLE_OBSERVABILITY_LOGGER="signal_throttle_observability"
SIGNAL_THROTTLE_RAW_LOG_ENABLED="true"
SIGNAL_THROTTLE_RAW_LOGGER="signal_throttle_raw"
SIGNAL_THROTTLE_RAW_LOG_PREFIX="[SignalThrottle]"
SIGNAL_THROTTLE_RAW_LOG_LEVEL="WARNING"
# Fusion V3 diagnostic lane. Pure ledger is gap-agnostic; execution remains OFF.
SIGNAL_THROTTLE_FUSION_V3_ENABLED="false"
SIGNAL_THROTTLE_PURE_LEDGER_ENABLED="true"
SIGNAL_THROTTLE_PURE_LEDGER_GAP_AGNOSTIC="true"
SIGNAL_THROTTLE_MICROBOOST_GAP_SPLIT_ENABLED="true"
SIGNAL_THROTTLE_FUSION_EXECUTION_ENABLED="false"
SIGNAL_THROTTLE_FUSION_DIAGNOSTIC_ENABLED="true"
SIGNAL_THROTTLE_FUSION_DIAGNOSTIC_INTERVAL_SECONDS="60"
SIGNAL_THROTTLE_FUSION_V3_LOGGER="signal_throttle_fusion_v3"
SIGNAL_THROTTLE_FUSION_V3_LOG_PREFIX="[SignalThrottleFusionV3]"
# Pressure tier is dashboard/observability priority only. It never changes
# final_direction, valid_for_execution, lot, SL/TP, RR, or order type.
SIGNAL_THROTTLE_PRESSURE_TIER_ENABLED="true"
SIGNAL_THROTTLE_PRESSURE_TIER_EXECUTION_IMPACT="false"
SIGNAL_THROTTLE_PRESSURE_TIER_LIVE_WINDOW_MINUTES="120"
SIGNAL_THROTTLE_PRESSURE_TIER_SESSION_WINDOW_HOURS="24"
SIGNAL_THROTTLE_PRESSURE_TIER_SNAPSHOT_LOG_ENABLED="true"
SIGNAL_THROTTLE_PRESSURE_TIER_SNAPSHOT_INTERVAL_SECONDS="60"
SIGNAL_THROTTLE_PRESSURE_TIER_SNAPSHOT_MAX_SYMBOLS_PER_TIER="12"
SIGNAL_THROTTLE_PRESSURE_TIER_SNAPSHOT_LOG_PREFIX="[SignalThrottlePressureTierSnapshot]"
SIGNAL_WATCH_PRESSURE_PRIORITY_CONTEXT_ENABLED="true"
SIGNAL_THROTTLE_ALLOWED_QUORUM_DECISION_UPDATE_ENABLED="true"
SIGNAL_THROTTLE_ALLOWED_QUORUM_DECISION_COOLDOWN_SECONDS="75"
SIGNAL_THROTTLE_NO_TRADE_DECISION_UPDATE_ENABLED="true"
SIGNAL_THROTTLE_NO_TRADE_DECISION_MIN_EVENTS="3"
SIGNAL_THROTTLE_NO_TRADE_DECISION_COOLDOWN_SECONDS="75"
# Direction propagation recovery for non-execute pressure observations.
# Master switch (C2): seed raw_direction onto non-execute canaries from current-tick sources.
SIGNAL_THROTTLE_PRESSURE_DIRECTION_RECOVERY="true"
# P2D' sub-canary: also recover raw_direction from execution.direction_diagnostics.sources
# (per-layer biases that survive after resolve_trade_direction collapses to HOLD).
# Conflict-safe + classification-only. Keep OFF until the P2D' runbook funnel check passes.
SIGNAL_THROTTLE_PRESSURE_DIRECTION_FROM_DIAGNOSTICS="false"
# Root#1/case-c: bridge latest allowed SignalThrottleIntel.raw_direction to a later
# same-symbol non-execute pressure canary when current-tick sources are empty.
# Classification-only: seeds canary raw_direction so microboost/counter classifiers can
# run; never sets final_direction/valid_for_execution and never emits SignalJSON.
# Conflict-safe + TTL bounded. Keep OFF until canaried.
SIGNAL_THROTTLE_INTEL_DIRECTION_BRIDGE_ENABLED="false"
SIGNAL_THROTTLE_INTEL_DIRECTION_BRIDGE_WINDOW_SECONDS="600"
# P2D'-B' (case-q): when a sub-threshold microboost block carries no direction but the
# SAME symbol's allowed_quorum context resolved BUY/SELL, stamp that direction (and a
# direction_recovery_source) onto the microboost watch-miss/shadow diagnostic. Symbol-matched,
# payload-only -- never changes the block, eligibility, watch path, or execution. Keep OFF
# until canaried; flag OFF = byte-identical diagnostic output.
MICROBOOST_WATCH_MISS_DIRECTION_RECOVERY_ENABLED="false"
# DecisionUpdate family lineage (source_family/source_stage/resolved_family/
# family_lineage_reason). Computed in-pipeline and now carried through the emitter
# (dataclass fix). Observability-only -- never an execution trigger, never changes
# decision/watch/SignalJSON counts. Default OFF = byte-identical (lineage was being
# dropped anyway); enable on a single deployment to canary, then verify 23h before
# considering default-on.
SIGNAL_FAMILY_LINEAGE_ENABLED="false"
# P1 startup diagnostic (default ON): emit one [SignalIntelligenceFlagSnapshot] line per
# deployment with the effective intelligence/canary flag state + deployment_id + commit_sha.
# Lets a capture distinguish "flag OFF" from "logic active but failing". Observability-only.
SIGNAL_INTELLIGENCE_FLAG_SNAPSHOT_ENABLED="true"
SIGNAL_JSON_MIN_RR_VALID="2.5"
SIGNAL_JSON_FINAL_BARRIER_ENABLED="true"
SIGNAL_JSON_EXEC_GATES_ENABLED="true"
SIGNAL_JSON_EXEC_GATES_ENFORCE="true"
SIGNAL_JSON_EXEC_GATES_EMIT_CONTINUATION="true"
SIGNAL_JSON_EXEC_GATES_EMIT_SIDECAR="true"
SIGNAL_JSON_EXEC_GATES_MAX_CHASE_R="0.35"
SIGNAL_EXECUTION_GATE_JSON_LOG_PREFIX="[SignalExecutionGateJSON]"
SIGNAL_JSON_TP1_RR_REQUIRED="2.0"
SIGNAL_JSON_COUNTER_ENTRY_RISK_MULTIPLIER="0.5"
SIGNAL_JSON_COUNTER_ENTRY_EXPIRY_MINUTES="30"
SIGNAL_JSON_REQUIRE_STRUCTURE_TARGET="true"
SIGNAL_JSON_ALLOW_RR_FALLBACK="true"
SIGNAL_JSON_DEDUP_BY_CLUSTER="true"
SIGNAL_BLOCK_FINALIZER_ENABLED="true"
SIGNAL_BLOCK_IDLE_FINALIZE_SECONDS="75"
SIGNAL_BLOCK_HARD_FINALIZE_SECONDS="300"
SIGNAL_BLOCK_PENDING_EXPIRES_AFTER_M15_BARS="3"

# HTF context canaries. Keep both OFF until their separate runbooks pass.
HTF_STRUCTURE_SNAPSHOT_ENABLED="false"
HTF_DAILY_PHASE_FEED_ENABLED="false"
# Freshness contracts for advisory HTF context. Stale Daily bias becomes STALE
# and is excluded from the Daily phase feed; liquidity resolution expires faster.
HTF_DAILY_BIAS_MAX_AGE_SECONDS="259200"
HTF_LIQUIDITY_RESOLUTION_MAX_AGE_SECONDS="21600"
# Patch A (flag-guarded, default OFF): when counter-entry is about to fall back to
# PROVISIONAL_RR_FALLBACK, emit a read-only [StructureLadderDiagnostic] showing whether
# H4/Daily structure + numeric levels exist, what market_context carries, and which fields
# are missing for FINAL_MARKET_STRUCTURE. Observability-only: execution_mutation=false, never
# changes target_mode/valid_for_execution/TP/SL/RR/SignalJSON. Proves where the chain breaks.
STRUCTURE_LADDER_DIAGNOSTIC_ENABLED="false"
# Assessment intelligence layers. Keep default OFF for canary rollout:
# 1) observe audit output, 2) enrich blockers, 3) only then consider promotion scoring.
SIGNAL_PRESSURE_CLUSTER_DEDUP_ENABLED="false"
SIGNAL_BASKET_DIRECTION_VALIDATION_ENABLED="false"
SIGNAL_DIRECTION_CONFLICT_RESOLVER_ENABLED="false"
SIGNAL_OUTCOME_MEMORY_ENABLED="false"
SIGNAL_REGIME_INVALIDATION_ENABLED="false"
SIGNAL_PROMOTION_SCORE_ENABLED="false"
SIGNAL_DECISION_GRANULAR_BLOCKERS_ENABLED="false"

# -----------------------
# FINNHUB (Market Feed)
# -----------------------
FINNHUB_API_KEY="YOUR_FINNHUB_API_KEY"
# Optional secondary key for automatic rotation on 429/auth errors.
FINNHUB_API_KEY_SECONDARY=""
# Optional extra backup keys. FINNHUB_API_KEY remains the primary key.
# FINNHUB_API_KEYS="backup_key1,backup_key2"
# Cooldown before a rate-limited key is retried (default 65s).
# FINNHUB_KEY_COOLDOWN_SEC="65"
# WebSocket URL (override if using premium endpoint)
# FINNHUB_WS_URL="wss://ws.finnhub.io"
# REST API base URL
# FINNHUB_REST_URL="https://finnhub.io/api/v1"

# Secondary REST candle provider. Used for M15/H1/H4/D1/W1/MN history
# when Finnhub REST is unavailable; it does not replace Finnhub WS ticks.
TWELVE_DATA_API_KEY=""
# Low-tier accounts commonly allow only 8 API credits per minute.
TWELVE_DATA_CREDITS_PER_MINUTE="8"
TWELVE_DATA_QUOTA_WINDOW_SEC="60"
TWELVE_DATA_QUOTA_COOLDOWN_SEC="65"

# Alpha Vantage REST candle fallback.
# Use either the official Alpha Vantage key or the RapidAPI wrapper key.
ALPHA_VANTAGE_API_KEY=""
ALPHA_VANTAGE_RAPIDAPI_KEY=""
ALPHA_VANTAGE_RAPIDAPI_HOST="alpha-vantage.p.rapidapi.com"
ALPHA_VANTAGE_CREDITS_PER_MINUTE="5"
ALPHA_VANTAGE_QUOTA_WINDOW_SEC="60"
ALPHA_VANTAGE_QUOTA_COOLDOWN_SEC="65"

# ---------------------------------------------------------------------------
# NEWS / ECONOMIC CALENDAR
# ---------------------------------------------------------------------------
# Primary provider:
#   forexfactory -> FF JSON primary (recommended)
#   finnhub      -> Finnhub primary (legacy mode)
#   off          -> Disable external calendar fetching
NEWS_PROVIDER="forexfactory"  # forexfactory | finnhub | off
NEWS_LOCK_ENABLED="true"      # true | false
# Enable HTML scraping as last-resort fallback (explicit opt-in only)
NEWS_FF_HTML_FALLBACK_ENABLED="false"
# Staleness threshold — refresh cached day events after N seconds (default 3600)
# NEWS_STALENESS_THRESHOLD_SEC="3600"

# Forex Factory JSON feed (primary provider)
FF_JSON_BASE_URL="https://nfs.faireconomy.media"
FF_JSON_TIMEOUT_SECONDS="10"
FF_JSON_MAX_RETRIES="3"

# Forex Factory XML feed (first fallback)
FF_XML_BASE_URL="https://www.forexfactory.com"
FF_XML_TIMEOUT_SECONDS="10"
FF_XML_MAX_RETRIES="3"

# Forex Factory HTML scraper (last resort — requires NEWS_FF_HTML_FALLBACK_ENABLED=true)
FF_HTML_URL="https://www.forexfactory.com/calendar"
FF_HTML_TIMEOUT_SECONDS="15"
FF_HTML_MAX_RETRIES="2"

# Finnhub economic calendar (secondary fallback / primary when NEWS_PROVIDER=finnhub)
# Base URL — override only if using a proxy or private endpoint
FINNHUB_BASE_URL="https://finnhub.io/api/v1"
FINNHUB_TIMEOUT_SECONDS="10"
FINNHUB_MAX_RETRIES="3"

# -----------------------
# REDIS (Storage / Snapshots / Context)
# -----------------------
REDIS_URL="redis://default:your_redis_password@redis.railway.internal:6379/0"
REDIS_PREFIX="wolf15"
REDIS_SOCKET_TIMEOUT_SEC="15"
REDIS_SOCKET_CONNECT_TIMEOUT_SEC="10"
REDIS_MAX_CONNECTIONS="50"
REDIS_POOL_TIMEOUT_SEC="5"
REDIS_HEALTH_CHECK_INTERVAL_SEC="30"
REDIS_RETRY_ATTEMPTS="5"
REDIS_RETRY_BACKOFF_BASE_SEC="1"
REDIS_RETRY_BACKOFF_CAP_SEC="10"
REDIS_SOCKET_KEEPALIVE="true"
# Vault Redis latency policy: successful PING <= degraded budget is nominal;
# above block budget analysis is blocked until Redis recovers.
VAULT_REDIS_DEGRADED_LATENCY_MS="100"
VAULT_REDIS_BLOCK_LATENCY_MS="500"
# Optional service-specific caps. Leave unset to inherit REDIS_MAX_CONNECTIONS.
# INGEST_REDIS_MAX_CONNECTIONS="50"
# REDIS_SYNC_MAX_CONNECTIONS="30"
# Keep warmup reads bounded during Redis/network pressure.
REDIS_WARMUP_MAX_CONCURRENCY="4"

# Candle history key prefixes — reader/consumer side (comma-separated, first-wins).
# Must match the prefix used by your ingest writer.
# Default (no override needed for standard deploys):
#   wolf15:candle_history,candle_history
# If writer uses a different namespace (e.g. deployed on a separate Redis DB),
# set this to the writer's prefix to fix bars=0 without any code changes.
CANDLE_HISTORY_KEY_PREFIXES="wolf15:candle_history,candle_history"

# PostgreSQL durable backup (optional write-behind persistence)
DATABASE_URL="postgresql://wolf_user:secure_password@localhost:5432/wolf_trading"
# Docker-compose Postgres credentials (must match DATABASE_URL above)
POSTGRES_USER="wolf_user"
POSTGRES_PASSWORD="secure_password"
POSTGRES_DB="wolf_trading"

# Context mode: local (in-memory) or redis (cross-container via Redis)
# - local: For single-process / local dev (default)
# - redis: For multi-container deployments (ingest + engine separation)
# Docker/Railway per-service start scripts override this to redis.
CONTEXT_MODE="local"

# -----------------------
# TELEGRAM ALERTS
# -----------------------
TELEGRAM_ENABLED="false"      # true | false
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID"

# -----------------------
# DASHBOARD (Read-Only)
# -----------------------
DASHBOARD_ENABLED="true"      # true | false
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT="8000"

# CORS origins (comma-separated)
# Dev: http://localhost:3000
# Vercel prod: https://<YOUR_DOMAIN>
# Vercel preview: https://*.vercel.app (add specific preview URLs as needed)
# IMPORTANT: No wildcard (*) when allow_credentials=True
CORS_ORIGINS="http://localhost:3000,https://tuyul-fx-dashboard.vercel.app"

# Optional extra Vercel FE domain (already supported in app_factory.py)
# Add preview URLs or custom domains here (comma-separated)
VERCEL_FRONTEND_URL=""

# API domain for CSP headers (set to your production API domain)
# Example: api.tuyulfx.com
API_DOMAIN="localhost"

# ── Cookie settings (production: SameSite=none requires Secure=true) ──
AUTH_COOKIE_NAME="wolf15_session"
AUTH_COOKIE_SECURE="true"
AUTH_COOKIE_SAMESITE="lax"          # lax | strict | none
AUTH_COOKIE_DOMAIN=""               # blank = browser default
AUTH_COOKIE_PATH="/"

# Dashboard auth secrets (only used by wolf15-api service; use >=32 random chars)
DASHBOARD_JWT_SECRET=""
DASHBOARD_JWT_ALGO="HS256"
DASHBOARD_TOKEN_EXPIRE_MIN="60"
# Optional static API key for service-to-service calls (EA, scripts)
DASHBOARD_API_KEY=""

# MT5 dumb-executor bridge (only used by the dedicated wolf15-ea-bridge service).
# Keep these separate from dashboard/user credentials. Generate independent
# random values with at least 32 bytes of entropy.
EXECUTOR_BRIDGE_AUTH_SECRET=""
EXECUTOR_BRIDGE_AUTH_SECRET_PREVIOUS=""
EXECUTOR_COMMAND_SIGNING_SECRET=""
EXECUTOR_COMMAND_SIGNING_SECRET_PREVIOUS=""
EXECUTOR_COMMAND_SIGNING_KEY_ID="exec-key-2026-07"
# New executor registrations are forced to SHADOW by the backend. Promotion to
# DEMO/LIVE must be a governed database change after shadow acceptance passes.
EA_BRIDGE_WORKERS="1"

# Production aliases (legacy-compatible in code)
JWT_SECRET="replace-with-strong-random-secret"
JWT_ALGORITHM="HS256"
JWT_TTL_MINUTES="30"

# -----------------------
# RATE LIMITING
# -----------------------
RATE_LIMIT_ENABLED="true"              # true | false
RATE_LIMIT_REQUESTS_PER_MIN="120"      # Max HTTP requests per IP per minute
RATE_LIMIT_BURST="20"                  # Extra burst tolerance above base rate
RATE_LIMIT_WS_PER_MIN="10"            # Max WebSocket upgrades per IP per minute
RATE_LIMIT_REDIS_PREFIX="ratelimit:"   # Redis key prefix for distributed limiter
RATE_LIMIT_BACKEND="redis"             # memory | redis (recommended for production)

# WebSocket hardening
WS_REQUIRE_AUTH="true"
WS_PING_INTERVAL="15"
WS_HEARTBEAT_TIMEOUT="30"
WS_MAX_CONNECTIONS="50"
WS_MAX_CONNECTIONS_PER_MIN="10"

# Governance hardening
COMPLIANCE_MODE_DEFAULT="true"
CONFIG_LOCK_PROTECTED_FIELDS="true"
REQUIRE_ADMIN_PIN_FOR_HIGH_RISK="true"
ADMIN_PIN_HASH=""

# Proxy / transport hardening
TRUSTED_PROXY_ENABLED="false"                       # Enable X-Forwarded-For parsing
RATE_LIMIT_TRUSTED_PROXY_IPS="127.0.0.1,::1"       # Comma-separated trusted proxy IPs (* for all)
FORCE_HTTPS="false"

# Stale data guard (context freshness threshold)
STALE_DATA_THRESHOLD_SEC="300"                      # Max age in seconds for context data before rejecting writes

# Audit controls
AUDIT_LOG_ENABLED="true"

# Price Feed & Monitoring
PRICE_FEED_INTERVAL_SEC="2"       # Interval for updating price cache from LiveContextBus
PRICE_WATCHER_INTERVAL_SEC="2"    # Interval for monitoring trade state transitions

# Analysis runtime scheduling
PIPELINE_TIMEOUT_SEC="30"                 # Hard deadline per pair pipeline run
ANALYSIS_MAX_CONCURRENT_PAIRS="4"         # Caps pair fan-out; prevents enrichment thread pileups
PIPELINE_ERROR_LOG_WINDOW_SEC="30"        # Rate-limit repeated pipeline timeout/error traces

# Default Account Settings
DEFAULT_ACCOUNT_BALANCE="100000"
DEFAULT_MAX_DAILY_DD_PERCENT="4.0"
DEFAULT_MAX_TOTAL_DD_PERCENT="8.0"

# -----------------------
# EXECUTION / EA INTERFACE
# (EA will read command outputs, not generate signals.)
# -----------------------
EA_BRIDGE_ENABLED="true"      # true | false
EA_COMMAND_OUT_DIR="./storage/ea_commands"
EA_STATE_IN_DIR="./storage/ea_state"

# -----------------------
# PROP FIRM / RISK SETTINGS (Runtime toggles)
# Hard thresholds remain inside config/constitution.yaml (locked).
# -----------------------
PROP_FIRM_MODE="true"         # true | false
MAX_CONCURRENT_TRADES="1"

# -----------------------
# CONSTITUTION PROFILE (Phase D — runtime profile selector)
# Activates a named profile from config/profiles/ on startup.
# Leave empty or "default" for pragmatic production baseline.
# -----------------------
WOLF15_CONSTITUTION_PROFILE=""  # "" | "default" | "wolf_curriculum_strict" | "production_pragmatic"

# -----------------------
# OPTIONAL: BROKER / MT5 bridge placeholders
# (If you run separate executor service)
# -----------------------
BROKER_EXECUTOR="off"         # off | mt5_bridge | custom
BROKER_ACCOUNT_ID=""
BROKER_SERVER=""
BROKER_PASSWORD=""

# -----------------------
# SECURITY / MISC
# -----------------------
ALLOW_MARKET_EXECUTION="false"  # MUST stay false (constitutional)
ALLOW_DASHBOARD_WRITE="false"    # MUST stay false (constitutional)

# Redis
# Production requirement (non-local): use rediss:// + password (AUTH)
# Set REDIS_ALLOW_INSECURE_IN_PROD=true only as temporary emergency override.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me_to_a_strong_random_password
REDIS_ALLOW_INSECURE_IN_PROD=false

# Railway Redis addon auto-injects these (no underscores).
# You do NOT need to set them manually — they are read as fallbacks
# when REDIS_URL and REDIS_HOST/PORT/PASSWORD are absent.
# REDISHOST=
# REDISPORT=
# REDISUSER=
# REDISPASSWORD=

# --- App Scaling ---
WEB_CONCURRENCY=1                    # Keep at 1 for WebSocket state consistency
APP_PORT=8000

# --- Task Supervisor Tuning ---
MAX_TASK_RESTARTS="20"              # Consecutive crash limit before giving up
RESTART_COOLDOWN_SEC="5.0"           # Initial cooldown between restarts
RESTART_COOLDOWN_MAX_SEC="120.0"     # Exponential cooldown ceiling
RESTART_SUCCESS_WINDOW_SEC="120.0"   # Run time before crash resets counter

# --- Single-Container Ingest ---
# Set to true when running API + ingest in the same container (Railway/Render)
# Set to false when ingest_service runs as a separate container
EMBED_INGEST="false"

# -----------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------
# Enable/disable tracing instrumentation.
# Both OTEL_ENABLED=true AND a valid OTEL_EXPORTER_OTLP_ENDPOINT are required
# for tracing to activate. Without an endpoint, tracing is fully disabled
# (no provider init, no instrumentation overhead).
OTEL_ENABLED="true"
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Set true for plain OTLP gRPC (most local Tempo setups); false for TLS.
OTEL_EXPORTER_OTLP_INSECURE="true"
# Service metadata attached to trace resource attributes.
OTEL_SERVICE_VERSION="dev"
OTEL_DEPLOYMENT_ENV="dev"
# Examples:
# - Local monitoring docker network: OTEL_EXPORTER_OTLP_ENDPOINT="http://tempo:4317"
# - Host-mapped local Tempo:       OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# -----------------------
# DISTRIBUTED SERVICES (Railway)
# -----------------------
# API service
ENGINE_MODE="paper"

# Engine service
ORCHESTRATOR_CHANNEL="wolf15:orchestrator:commands"

# Role-scoped runtime identity and readiness wiring
# Set per service:
#   API -> WOLF15_SERVICE_ROLE=api
#   Engine -> WOLF15_SERVICE_ROLE=engine
#   Ingest -> WOLF15_SERVICE_ROLE=ingest
#   Orchestrator -> WOLF15_SERVICE_ROLE=orchestrator
WOLF15_SERVICE_ROLE="api"

# Engine service readiness probe port wiring
ENGINE_HEALTH_PORT="8081"                   # set to ${PORT} in Railway
# Optional external SignalThrottle/log-source health probe. Use /healthz for
# unauthenticated connectivity checks; use /status with HEALTH_PROBE_TOKEN only
# when the caller needs authenticated engine details.
ENGINE_LOG_SOURCE_URL="http://wolf-engine:8081/healthz"

# Ingest service readiness probe port wiring
INGEST_HEALTH_PORT="8082"                   # set to ${PORT} in Railway

# Orchestrator service readiness/heartbeat wiring
ORCHESTRATOR_HEALTH_PORT="8083"             # set to ${PORT} in Railway
ORCHESTRATOR_HEARTBEAT_INTERVAL_SEC="30"    # readiness threshold derives from this

# ---------------------------------------------------------------------------
# VERCEL DASHBOARD — Required env vars (set in Vercel project settings)
# ---------------------------------------------------------------------------
# These variables MUST be set in your Vercel project for the dashboard to work.
#
# NEXT_PUBLIC_* variables are baked into the browser bundle at build time.
# INTERNAL_API_URL is server-side only (never sent to the browser).
#
#   NEXT_PUBLIC_API_BASE_URL  — Base URL of the Railway API service.
#                               Used by client components for fetch/axios calls.
#                               Example: https://wolf15-api.up.railway.app
#
#   NEXT_PUBLIC_WS_BASE_URL   — WebSocket origin (bare wss:// host, NO path).
#                               MUST NOT include /ws, /ws/live, or any path.
#                               Example: wss://wolf15-api.up.railway.app
#
#   INTERNAL_API_URL          — Server-side proxy URL (can use Railway private
#                               network URL for lower latency).  Falls back to
#                               NEXT_PUBLIC_API_BASE_URL when not set.
#                               Example: https://wolf15-api.railway.internal
#
# next.config.ts resolves the backend URL in order:
#   INTERNAL_API_URL → NEXT_PUBLIC_API_BASE_URL → API_BASE_URL → API_DOMAIN
NEXT_PUBLIC_API_BASE_URL=https://your-api.up.railway.app
# MUST be the bare wss:// origin — NO /ws or /ws/live path suffix!
NEXT_PUBLIC_WS_BASE_URL=wss://your-api.up.railway.app
# Optional: use Railway private-network URL for server-side proxy (faster)
# INTERNAL_API_URL=https://your-api.railway.internal

# Optional: Dashboard-BFF upstream (server-side, no trailing slash).
# When set, the proxy routes BFF-allowlisted paths to this URL.
# Non-allowlisted paths always route to core-api.
# INTERNAL_DASHBOARD_BFF_URL=https://wolf15-dashboard-bff.railway.internal

# ---------------------------------------------------------------------------
# RAILWAY SERVICE: wolf15-api — Required env var references
# ---------------------------------------------------------------------------
# In Railway, set these as reference variables pointing to the addon:
#   REDIS_URL          = ${{Redis.REDIS_URL}}         (or REDIS_PRIVATE_URL)
#   DATABASE_URL       = ${{Postgres.DATABASE_URL}}
#   DASHBOARD_JWT_SECRET = <random >=32 char string>  (openssl rand -hex 32)
#   DASHBOARD_API_KEY  = <random string for EA/service auth>
#
# Without REDIS_URL the API falls back to redis://localhost:6379/0 (broken on Railway).
# Without DATABASE_URL Alembic migrations won't run and trade_outbox table won't exist.
# Without DASHBOARD_JWT_SECRET (>=32 chars) JWT auth fails closed (API-key auth still works).
